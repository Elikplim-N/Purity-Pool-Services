# Supabase Postgres connection strings
# (Supabase dashboard → Project Settings → Database → Connection string)
#
# DATABASE_URL: the *pooled* connection (port 6543, pgbouncer) — used by the app.
# DIRECT_URL:   the *direct* connection (port 5432) — used by Prisma migrations.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Admin login credentials (change these for production use)
ADMIN_EMAIL="admin@puritypoolservices.com"
ADMIN_PASSWORD="PoolAdmin123!"

# Secret used to sign the admin session cookie (change for production use)
SESSION_SECRET="change-me-to-a-long-random-string"
